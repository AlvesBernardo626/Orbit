NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/orbit?replicaSet=rs0
# Generate locally with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-48-characters
CORS_ORIGINS=http://127.0.0.1:5173,orbit://app
TRUST_PROXY_HOPS=0
REGISTRATION_ENABLED=true
STUN_URLS=stun:stun.l.google.com:19302
# coturn compatible time-limited credentials (HMAC-SHA1), never sent as a static secret to clients.
TURN_URLS=
TURN_SECRET=
ICE_RELAY_ONLY=false
# Public build configuration; these are NOT secrets. Rebuild desktop when changing the endpoint.
VITE_API_URL=http://127.0.0.1:3001
DESKTOP_DEV_URL=http://127.0.0.1:5173
ORBIT_BROWSER_ONLY=false
# Isolated automated browser tests (never reuse production endpoints).
E2E_API_URL=http://127.0.0.1:43101
E2E_DESKTOP_URL=http://127.0.0.1:43173
